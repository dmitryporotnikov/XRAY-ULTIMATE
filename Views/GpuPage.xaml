<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XRAY_ULTIMATE.Views.GpuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XRAY_ULTIMATE.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,40">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <!-- GPU Header Card (matching CpuPage design) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Width="64" Height="64" Margin="0,0,20,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE790;" FontSize="32" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtGpuHeaderTitle" Text="Graphics Accelerators &amp; Display" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="TxtGpuHeaderSub" Text="DirectX / WDDM Video Controllers &amp; Output Displays" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <TextBlock x:Name="TxtGpuCount" Text="Adapters: -" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtMonCount" Text="Displays: -" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Key Metric Cards -->
            <TextBlock Text="Primary Video Accelerator" FontSize="18" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16" Margin="0,-8,0,0">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Primary Adapter" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtPrimaryGpuName" Text="-" FontSize="16" FontWeight="Bold" TextWrapping="WrapWholeWords" MaxLines="2" />
                        <TextBlock x:Name="TxtPrimaryDriver" Text="Driver: -" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Installed Video RAM (VRAM)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtPrimaryVram" Text="-" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="Dedicated graphics buffer" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Active Display Mode" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtPrimaryMode" Text="-" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Current resolution &amp; refresh rate" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- GPU Adapters Cards List -->
            <TextBlock Text="Installed Graphics Controllers" FontSize="18" FontWeight="SemiBold" />
            <ItemsControl x:Name="LstGpus">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:GraphicsCardInfo">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE790;" FontSize="26" Foreground="White" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="Bold" />
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind VideoProcessor}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{x:Bind FormattedDriver}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind DriverDate}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind FormattedResolution}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FormattedVram}" FontSize="13" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Connected Monitors -->
            <TextBlock Text="Connected Displays &amp; Monitors" FontSize="18" FontWeight="SemiBold" />
            <ItemsControl x:Name="LstMonitors">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MonitorInfo">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <FontIcon Glyph="&#xE7F4;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Manufacturer}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind MonitorType}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Detailed Properties Table Grouped by Category -->
            <TextBlock Text="Detailed Graphics Properties" FontSize="18" FontWeight="SemiBold" />
            <ItemsControl x:Name="LstGpuPropertyGroups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PropertyGroup">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,12"
                                Margin="0,0,0,16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Width="4" Height="16" />
                                    <TextBlock Text="{x:Bind Category}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </StackPanel>

                                <ListView ItemsSource="{x:Bind Items}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:PropertyItem">
                                            <Grid ColumnDefinitions="260,*" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Text="{x:Bind Property}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayValue}" FontSize="13" FontWeight="Medium" IsTextSelectionEnabled="True" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
