<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XRAY_ULTIMATE.Views.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,40">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <!-- Header Banner -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Width="64" Height="64" Margin="0,0,20,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE78C;" FontSize="32" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Export System Diagnostics Report" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Generate complete, audit-grade hardware and software diagnostic reports" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status Notification InfoBar -->
            <InfoBar x:Name="IbExportStatus" IsOpen="False" Severity="Success" Title="Report Exported Successfully" Message="File saved." Margin="0,-8,0,0">
                <InfoBar.ActionButton>
                    <Button x:Name="BtnOpenFile" Content="Open File" Click="BtnOpenFile_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Export Formats Grid -->
            <TextBlock Text="Select Export Format" FontSize="18" FontWeight="SemiBold" />

            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="16" Margin="0,-8,0,0">
                <!-- HTML Report Option -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="24,20">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Background="#1e293b" CornerRadius="10" Width="52" Height="52" Margin="0,0,20,0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE774;" FontSize="24" Foreground="#38bdf8" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Interactive HTML Report (.html)" FontSize="16" FontWeight="Bold" />
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,1">
                                    <TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Stylized dark/light responsive layout with summary cards, property matrices, dsregcmd diagnostics, and print optimization." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="BtnExportHtml" Click="BtnExportHtml_Click" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                <TextBlock Text="Export HTML" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- JSON Report Option -->
                <Border Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="24,20">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Background="#1e293b" CornerRadius="10" Width="52" Height="52" Margin="0,0,20,0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE943;" FontSize="24" Foreground="#a78bfa" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Structured JSON Report (.json)" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Complete machine-readable JSON structure ideal for enterprise CMDB ingestion, automated security analysis, and archiving." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="BtnExportJson" Click="BtnExportJson_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                <TextBlock Text="Export JSON" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Plain Text Report Option -->
                <Border Grid.Row="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="24,20">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Background="#1e293b" CornerRadius="10" Width="52" Height="52" Margin="0,0,20,0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8C4;" FontSize="24" Foreground="#34d399" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Plain Text / Markdown Report (.txt)" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Formatted ASCII text report formatted for pasting directly into IT tickets, service desks, GitHub issues, or emails." FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="2" x:Name="BtnExportTxt" Click="BtnExportTxt_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                <TextBlock Text="Export TXT" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
