<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XRAY_ULTIMATE.Views.AcpiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XRAY_ULTIMATE.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,40">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <!-- Header Banner Card (matching CpuPage design) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Width="64" Height="64" Margin="0,0,20,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE943;" FontSize="32" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="ACPI &amp; DSDT Firmware Explorer" FontSize="22" FontWeight="Bold" />
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="FIRMWARE" FontSize="10" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtAcpiHeaderSub" Text="Advanced Configuration and Power Interface - System Firmware Tables" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TxtAcpiMeta" Text="DSDT Size: - | OEM ID: - | Tables: -" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="BtnExportDsl" Click="BtnExportDsl_Click" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C4;" FontSize="13" />
                                <TextBlock Text="Export ASL/DSL (.dsl)" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnExportDsdt" Click="BtnExportDsdt_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                <TextBlock Text="Export Binary (.aml)" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Loading Indicator Card -->
            <Border x:Name="BrdAcpiLoading"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32,28"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" Spacing="16">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock Text="Loading ACPI System Firmware Tables..." FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Decompiling AML machine bytecode and parsing hardware descriptors" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Main Content Container -->
            <StackPanel x:Name="PanelAcpiContent" Spacing="24" Visibility="Collapsed">
                <!-- Mode Switch: DSDT vs ASL/DSL vs All ACPI Tables -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <RadioButton x:Name="RbDsdt" Content="DSDT Deep Inspection" IsChecked="True" Checked="ViewMode_Changed" FontWeight="SemiBold" />
                    <RadioButton x:Name="RbAsl" Content="ASL / DSL Disassembly" Checked="ViewMode_Changed" FontWeight="SemiBold" />
                    <RadioButton x:Name="RbAllTables" Content="All ACPI Firmware Tables" Checked="ViewMode_Changed" FontWeight="SemiBold" />
                </StackPanel>

            <!-- DSDT Container -->
            <StackPanel x:Name="PanelDsdt" Spacing="24">
                <!-- DSDT Header Card -->
                <TextBlock Text="DSDT Header &amp; Metadata" FontSize="18" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16" Margin="0,-8,0,0">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Table Signature" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="DSDT" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Differentiated System Description" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Binary Table Size" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtDsdtSize" Text="-" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="AML Machine Bytecode" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="OEM ID &amp; Table ID" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtDsdtOem" Text="-" FontSize="18" FontWeight="Bold" />
                            <TextBlock x:Name="TxtDsdtOemTable" Text="-" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Creator / Compiler" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                            <TextBlock x:Name="TxtDsdtCreator" Text="-" FontSize="18" FontWeight="Bold" />
                            <TextBlock x:Name="TxtDsdtRev" Text="Revision: -" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Discovered ACPI Objects & Devices -->
                <TextBlock Text="Discovered ACPI Hardware Objects &amp; Scopes in DSDT" FontSize="18" FontWeight="SemiBold" />
                <ListView x:Name="LstAcpiObjects" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AcpiDeviceObject">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,3">
                                <Grid ColumnDefinitions="140,200,*">
                                    <TextBlock Text="{x:Bind Path}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ObjectType}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Hex / ASCII Preview (Scrollable) -->
                <TextBlock Text="DSDT AML Binary Dump (First 1.5 KB Header &amp; Definitions)" FontSize="18" FontWeight="SemiBold" />
                <Border Background="#090d14"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <TextBox x:Name="TxtDsdtHex"
                             Height="360"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             Foreground="#cbd5e1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollMode="Enabled"
                             ScrollViewer.HorizontalScrollMode="Enabled" />
                </Border>
            </StackPanel>

            <!-- ASL / DSL Disassembly Container (Scrollable) -->
            <StackPanel x:Name="PanelAsl" Spacing="16" Visibility="Collapsed">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Decompiled ACPI Source Language (ASL / DSL)" FontSize="18" FontWeight="SemiBold" />
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,1">
                                <TextBlock x:Name="TxtAslStats" Text="Lines: 0" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Disassembled from AML bytecode into clean, compilable ASL source" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="BtnCopyAsl" Click="BtnCopyAsl_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                <TextBlock Text="Copy ASL" />
                            </StackPanel>
                        </Button>
                        <Button Click="BtnExportDsl_Click" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                <TextBlock Text="Save .dsl File" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Background="#090d14"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <TextBox x:Name="TxtAslSource"
                             Height="600"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             Foreground="#e2e8f0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollMode="Enabled"
                             ScrollViewer.HorizontalScrollMode="Enabled" />
                </Border>
            </StackPanel>

            <!-- All ACPI Tables Container -->
            <StackPanel x:Name="PanelAllTables" Spacing="16" Visibility="Collapsed">
                <TextBlock Text="Complete ACPI Firmware Table Manifest" FontSize="18" FontWeight="SemiBold" />
                <ListView x:Name="LstAllAcpiTables" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AcpiTableItem">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,4">
                                <Grid ColumnDefinitions="100,*,140,160,100">
                                    <TextBlock Text="{x:Bind TableSignature}" FontWeight="Bold" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind TableDescription}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind OemTableId}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind FormattedLength}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind FormattedOem}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Border Grid.Column="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind CreatorId}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ScrollViewer>
</Page>
