<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XRAY_ULTIMATE.Views.SensorsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,40">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <!-- Header Toolbar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Real-Time Sensor Telemetry" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Continuous live polling of CPU, memory, and network throughput" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Update Interval:" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="CmbInterval" SelectedIndex="1" SelectionChanged="CmbInterval_SelectionChanged">
                            <ComboBoxItem Content="500 ms" />
                            <ComboBoxItem Content="1.0 s" />
                            <ComboBoxItem Content="2.0 s" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Loading Indicator Card -->
            <Border x:Name="BrdSensorsLoading"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32,28"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" Spacing="16">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock Text="Initializing Real-Time Sensor Telemetry..." FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Attaching to CPU, GPU, memory, and network performance counters" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Main Content Container -->
            <StackPanel x:Name="PanelSensorsContent" Spacing="24" Visibility="Collapsed">
                <!-- Live CPU & RAM Gauges -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- CPU Meter -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="24,20">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE950;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="CPU Total Load" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="TxtCpuLive" Text="0.0%" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <ProgressBar x:Name="PrgCpuLive" Value="0" Maximum="100" Height="10" CornerRadius="5" />
                        <TextBlock x:Name="TxtCpuLiveSub" Text="Active Processor Threads" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- RAM Meter -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="24,20">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE964;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="RAM Physical Load" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="TxtRamLive" Text="0%" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <ProgressBar x:Name="PrgRamLive" Value="0" Maximum="100" Height="10" CornerRadius="5" />
                        <TextBlock x:Name="TxtRamLiveSub" Text="Used: 0 GB / Total: 0 GB" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Thermal & Temperature Sensors -->
            <TextBlock Text="Thermal &amp; Temperature Sensors" FontSize="18" FontWeight="SemiBold" />
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="16" Margin="0,-8,0,0">
                <!-- CPU Package Temperature -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7A7;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="CPU Package" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border Grid.Column="1" x:Name="BrdTempStatus" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtThermalStatus" Text="Optimal" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TxtCpuTemp" Text="45.0 °C" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <ProgressBar x:Name="PrgCpuTemp" Value="45" Maximum="105" Height="8" CornerRadius="4" />
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock x:Name="TxtCpuTempF" Text="113.0 °F" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="TxtCritPoint" Grid.Column="1" Text="Throttle: 100 °C" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- GPU Core Temperature -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="GPU Core" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                            <Border Grid.Column="1" x:Name="BrdGpuTempStatus" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtGpuThermalStatus" Text="Optimal" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TxtGpuTemp" Text="47.0 °C" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <ProgressBar x:Name="PrgGpuTemp" Value="47" Maximum="100" Height="8" CornerRadius="4" />
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock x:Name="TxtGpuNameSensor" Text="Graphics Processor" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtGpuTempF" Grid.Column="1" Text="116.6 °F" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- System / Thermal Zone Temperature -->
                <Border Grid.Row="1" Grid.Column="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEB51;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Chassis / Motherboard" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="TxtSysTemp" Text="38.0 °C" FontSize="28" FontWeight="Bold" />
                        <ProgressBar x:Name="PrgSysTemp" Value="38" Maximum="100" Height="8" CornerRadius="4" />
                        <TextBlock Text="Ambient motherboard &amp; VRM zone" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Storage / NVMe Temperature -->
                <Border Grid.Row="1" Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20,16">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDA2;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Primary Storage (NVMe / SSD)" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="TxtDriveTemp" Text="39.0 °C" FontSize="28" FontWeight="Bold" />
                        <ProgressBar x:Name="PrgDriveTemp" Value="39" Maximum="85" Height="8" CornerRadius="4" />
                        <TextBlock Text="NAND flash controller operating thermal" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Network & Uptime Cards -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <!-- Network Throughput -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="24,20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE704;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Network Live Bandwidth" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Download (Rx)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TxtNetRx" Text="0.0 Kbps" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Upload (Tx)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TxtNetTx" Text="0.0 Kbps" FontSize="20" FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- System Uptime -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="24,20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE823;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Continuous System Uptime" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="TxtLiveUptime" Text="0d 0h 0m 0s" FontSize="26" FontWeight="Bold" Margin="0,8,0,0" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="High-resolution monotonic timer" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </StackPanel>
</ScrollViewer>
</Page>
