<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XRAY_ULTIMATE.Views.SoftwarePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XRAY_ULTIMATE.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,40">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <!-- Header Banner Card (matching CpuPage design) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Width="64" Height="64" Margin="0,0,20,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE71D;" FontSize="32" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Installed Software Applications" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="64-bit Native, 32-bit (WOW64) &amp; User Registered Programs" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtAppCount" Text="Installed Software (0)" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Click="BtnOpenWindowsInstalledApps_Click" ToolTipService.ToolTip="Open default Windows Installed Apps &amp; Features">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71D;" FontSize="13" />
                                <TextBlock Text="Windows Installed Apps" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnExportCsv" Click="BtnExportCsv_Click" Style="{ThemeResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="13" />
                                <TextBlock Text="Export CSV" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Loading Indicator Card -->
            <Border x:Name="BrdSoftwareLoading"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32,28"
                    Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" Spacing="16">
                    <ProgressRing IsActive="True" Width="36" Height="36" />
                    <TextBlock Text="Loading Installed Applications..." FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Reading registry software manifests and package definitions" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Main Content Container -->
            <StackPanel x:Name="PanelSoftwareContent" Spacing="24" Visibility="Collapsed">
                <!-- Search & Architecture Filter Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBox x:Name="TxtSearch" PlaceholderText="Search applications by name or publisher..." TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center" />

                    <ComboBox x:Name="CmbArchFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="CmbArchFilter_SelectionChanged" VerticalAlignment="Center">
                        <ComboBoxItem Content="All Architectures" />
                        <ComboBoxItem Content="64-bit Only" />
                        <ComboBoxItem Content="32-bit Only" />
                        <ComboBoxItem Content="User Only" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Uninstall Status Notification -->
            <InfoBar x:Name="IbUninstallStatus" IsOpen="False" Margin="0,-8,0,0" />

            <!-- Applications List Container -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,8">
                <ListView x:Name="LstSoftware" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:InstalledApplication">
                            <Grid ColumnDefinitions="*,150,160,85,65,Auto" Padding="12,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind InstallLocation}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayVersion}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Publisher}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind InstallDate}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Architecture}" FontSize="11" FontWeight="SemiBold" />
                                </Border>
                                <Button Grid.Column="5" Click="BtnUninstall_Click" Tag="{x:Bind}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTipService.ToolTip="Uninstall this application">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#ef4444" />
                                        <TextBlock Text="Uninstall" FontSize="11" Foreground="#ef4444" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </StackPanel>
</ScrollViewer>
</Page>
