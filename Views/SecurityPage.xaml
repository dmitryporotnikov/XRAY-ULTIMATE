<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XRAY_ULTIMATE.Views.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XRAY_ULTIMATE.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,40">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <!-- Header Banner Card (matching CpuPage design) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Width="64" Height="64" Margin="0,0,20,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEA18;" FontSize="32" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Platform Security &amp; Hardware Integrity" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Silicon Root of Trust, Secure Boot Firmware &amp; Endpoint Protection" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <Border x:Name="BrdTpmBadge" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHeaderTpmBadge" Text="TPM 2.0" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <Border x:Name="BrdSbBadge" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHeaderSbBadge" Text="Secure Boot: -" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHeaderAvBadge" Text="Antivirus: -" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2" Click="BtnOpenWindowsSecurity_Click" ToolTipService.ToolTip="Open Windows Security Center (windowsdefender: / wscui.cpl)" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA18;" FontSize="13" />
                            <TextBlock Text="Windows Security Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Security Overview Cards -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <!-- TPM Card -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA18;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Trusted Platform Module (TPM)" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="TxtTpmSpec" Text="TPM 2.0" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="TxtTpmStatus" Text="Activated &amp; Enabled" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TxtTpmMfg" Text="Manufacturer: -" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Secure Boot & UAC Card -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Boot Integrity &amp; Access Control" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="TxtSecureBoot" Text="Secure Boot: Enabled" FontSize="16" FontWeight="Bold" />
                        <TextBlock x:Name="TxtUac" Text="User Account Control: Enabled" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Firmware Protection Active" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Antivirus Card -->
                <Border Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B8;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Antivirus Protection" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="TxtAvName" Text="Windows Defender" FontSize="16" FontWeight="Bold" />
                        <TextBlock x:Name="TxtAvStatus" Text="Real-time Protection Active" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Signatures Up to Date" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- BitLocker Drives -->
            <TextBlock Text="BitLocker Drive Encryption" FontSize="18" FontWeight="SemiBold" />
            <ListView x:Name="LstBitLocker" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:BitLockerInfo">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <FontIcon Glyph="&#xE875;" FontSize="22" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DriveLetter}" FontSize="15" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind EncryptionMethod}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ProtectionStatus}" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Installed Windows Hotfixes -->
            <TextBlock Text="Installed Windows Updates &amp; Hotfixes" FontSize="18" FontWeight="SemiBold" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MaxHeight="260"
                    Padding="4,8">
                <ListView x:Name="LstHotfixes" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:HotfixInfo">
                            <Grid ColumnDefinitions="140,*,120" Padding="12,6">
                                <TextBlock Text="{x:Bind HotFixId}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind InstalledOn}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Detailed Properties Table Grouped by Category -->
            <TextBlock Text="Detailed Security Parameters" FontSize="18" FontWeight="SemiBold" />
            <ItemsControl x:Name="LstSecurityPropertyGroups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PropertyGroup">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,12"
                                Margin="0,0,0,16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Width="4" Height="16" />
                                    <TextBlock Text="{x:Bind Category}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </StackPanel>

                                <ListView ItemsSource="{x:Bind Items}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:PropertyItem">
                                             <Grid ColumnDefinitions="260,*" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Text="{x:Bind Property}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayValue}" FontSize="13" FontWeight="Medium" IsTextSelectionEnabled="True" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
