<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XRAY_ULTIMATE.Views.BenchmarkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,40">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <!-- Header Banner -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Width="64" Height="64" Margin="0,0,20,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE9D9;" FontSize="32" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Hardware Performance Benchmark" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="TxtBenchmarkCpu" Text="Target: Multi-core CPU &amp; Memory Subsystem" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TxtStatus" Text="Ready to benchmark system components." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="BtnRunBenchmark" Click="BtnRunBenchmark_Click" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="PrgRing" Width="16" Height="16" Visibility="Collapsed" Foreground="White" />
                            <FontIcon x:Name="IconRun" Glyph="&#xE768;" FontSize="13" />
                            <TextBlock x:Name="TxtBtnText" Text="Run Benchmark" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- CPU Benchmark Scores -->
            <TextBlock Text="Processor Performance (Compute &amp; Cryptography)" FontSize="18" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,-8,0,0">
                <!-- Single-Thread Score -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE950;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Single-Core Performance" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="TxtSingleScore" Text="-" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="Single thread integer, math, and SHA-256 throughput" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Multi-Thread Score -->
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE7F8;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Multi-Core Performance" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="TxtMultiScore" Text="-" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="TxtScaling" Text="Parallel execution scaling: -" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Memory Subsystem Scores -->
            <TextBlock Text="Memory Bandwidth &amp; Latency (RAM Subsystem)" FontSize="18" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16" Margin="0,-8,0,0">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Memory Read" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtMemRead" Text="-" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Sequential buffer read" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Memory Write" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtMemWrite" Text="-" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Sequential buffer write" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Memory Copy" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtMemCopy" Text="-" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Inter-buffer BlockCopy" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Memory Latency" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtMemLatency" Text="-" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Pointer-chasing cycle latency" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
