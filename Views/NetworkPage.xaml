<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XRAY_ULTIMATE.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XRAY_ULTIMATE.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,40">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <!-- Wi-Fi Diagnostics Card (if available) -->
            <Border x:Name="BrdWifi" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20"
                    Visibility="Collapsed">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE701;" FontSize="24" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="TxtWifiSsid" Text="Wi-Fi SSID" FontSize="18" FontWeight="Bold" />
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                <TextBlock x:Name="TxtWifiRadio" Text="802.11ax" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                <TextBlock x:Name="TxtWifiChannel" Text="Channel: 36" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtWifiSecurity" Text="WPA2-Personal (AES)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TxtWifiRates" Text="Rx: - | Tx: -" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtWifiSignal" Text="100%" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="Signal Quality" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" x:Name="PrgWifiSignal" Value="100" Maximum="100" Height="6" CornerRadius="3" />
                </Grid>
            </Border>

            <!-- Network Adapters List -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Network Adapters &amp; Interfaces" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="BtnOpenNcpa" Click="BtnOpenNcpa_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                        <TextBlock Text="ncpa.cpl" />
                    </StackPanel>
                </Button>
            </Grid>

            <ItemsControl x:Name="LstAdapters">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:NetworkAdapterInfo">
                        <Expander IsExpanded="{x:Bind IsUp}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,12">
                            <Expander.Header>
                                <Grid ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch" Padding="4,2">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="Bold" />
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                                <TextBlock Text="{x:Bind InterfaceType}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <TextBlock Text="{x:Bind FormattedIpv4}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="{x:Bind MacAddress}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FormattedSpeed}" FontSize="12" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Expander.Header>

                            <!-- Detailed Adapter Info Embedded Directly Inside the Expander -->
                            <StackPanel Spacing="0" Padding="12,4,12,12">
                                <Grid ColumnDefinitions="220,*" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Adapter Description / Hardware" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Description}" FontSize="12" FontWeight="SemiBold" IsTextSelectionEnabled="True" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                                <Grid ColumnDefinitions="220,*" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="IPv4 Address(es)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind FormattedIpv4}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" IsTextSelectionEnabled="True" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                                <Grid ColumnDefinitions="220,*" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="IPv6 Address(es)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind FormattedIpv6}" FontSize="12" FontWeight="Medium" IsTextSelectionEnabled="True" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                                <Grid ColumnDefinitions="220,*" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Default Gateway(s)" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind FormattedGateways}" FontSize="12" FontWeight="Medium" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="220,*" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="DNS Servers" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind FormattedDns}" FontSize="12" FontWeight="Medium" IsTextSelectionEnabled="True" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                                <Grid ColumnDefinitions="220,*" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="DHCP Server / Assignment" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind FormattedDhcp}" FontSize="12" FontWeight="Medium" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="220,*" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Text="MAC (Physical) Address" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind MacAddress}" FontSize="12" FontWeight="Medium" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="220,*" Padding="8,6">
                                    <TextBlock Text="Operational Status &amp; Link Speed" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind FormattedSpeed}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
