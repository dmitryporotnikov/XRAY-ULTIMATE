<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XRAY_ULTIMATE.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XRAY_ULTIMATE.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,40">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <!-- Header Banner Card (matching CpuPage design) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Width="64" Height="64" Margin="0,0,20,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEDA2;" FontSize="32" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Storage Controllers &amp; Disk Drives" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Physical NVMe/SATA Disk Drives, SMART Status &amp; Logical Volumes" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtDrivesCount" Text="Drives: -" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtVolumesCount" Text="Volumes: -" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2" Click="BtnOpenDiskManagement_Click" ToolTipService.ToolTip="Open Windows Disk Management (diskmgmt.msc)" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEDA2;" FontSize="13" />
                            <TextBlock Text="Disk Management" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Logical Volumes -->
            <TextBlock Text="Logical Volumes &amp; Partitions" FontSize="18" FontWeight="SemiBold" />
            <ListView x:Name="LstVolumes" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:VolumeInfo">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,4">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="8">
                                <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="20" Foreground="White" />
                                </Border>
                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DriveLetter}" FontSize="16" FontWeight="Bold" />
                                        <TextBlock Text="{x:Bind VolumeLabel}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{x:Bind FileSystem}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind DriveType}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Bind FormattedPercent}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Value="{x:Bind PercentUsed}" Maximum="100" Height="8" CornerRadius="4" />

                                <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,*">
                                    <TextBlock Text="{x:Bind FormattedUsed}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind FormattedFree}" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Physical Disks -->
            <TextBlock Text="Physical Storage Hardware (Drives)" FontSize="18" FontWeight="SemiBold" />
            <ListView x:Name="LstDisks" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PhysicalDiskInfo">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <FontIcon Glyph="&#xE958;" FontSize="24" Foreground="{ThemeResource AccentFillColorDefaultBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Model}" FontSize="15" FontWeight="Bold" />
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{x:Bind MediaType}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{x:Bind InterfaceType}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{x:Bind SerialNumber}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind FirmwareRevision}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind Status}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="2" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FormattedSize}" FontSize="13" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Detailed Properties Grouped by Category / Drive -->
            <TextBlock Text="Detailed Storage Parameters" FontSize="18" FontWeight="SemiBold" />
            <ItemsControl x:Name="LstStoragePropertyGroups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PropertyGroup">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,12"
                                Margin="0,0,0,16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Width="4" Height="16" />
                                    <TextBlock Text="{x:Bind Category}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </StackPanel>

                                <ListView ItemsSource="{x:Bind Items}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:PropertyItem">
                                            <Grid ColumnDefinitions="260,*" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Text="{x:Bind Property}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayValue}" FontSize="13" FontWeight="Medium" IsTextSelectionEnabled="True" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
