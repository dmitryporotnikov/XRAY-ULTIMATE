<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XRAY_ULTIMATE.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XRAY_ULTIMATE.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,40">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <!-- Physical RAM Main Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Width="64" Height="64" Margin="0,0,20,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE964;" FontSize="32" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Physical System Memory" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="TxtRamSummary" Text="Total: - | Available: - | Used: -" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Row="0" Grid.Column="2" x:Name="TxtRamPercentLarge" Text="0%" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                    <!-- Memory Usage Bar -->
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" x:Name="PrgRamLarge" Height="10" Value="0" Maximum="100" CornerRadius="5" />

                    <!-- Footnotes -->
                    <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,*,*">
                        <TextBlock x:Name="TxtPhysTotal" Text="Total RAM: -" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" x:Name="TxtPhysUsed" Text="Used RAM: -" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" x:Name="TxtPhysAvail" Text="Available RAM: -" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Paging & Virtual Memory Cards -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Paging / Swap File" FontSize="15" FontWeight="SemiBold" />
                        <ProgressBar x:Name="PrgPagefile" Value="0" Maximum="100" Margin="0,4" />
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock x:Name="TxtPagefileUsed" Text="Used: -" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" x:Name="TxtPagefileTotal" Text="Total: -" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Virtual Memory Allocation" FontSize="15" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                            <TextBlock x:Name="TxtVirtTotal" Text="Total: -" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" x:Name="TxtVirtAvail" Text="Available: -" FontSize="13" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Physical DIMM Slots -->
            <TextBlock Text="Installed Memory Modules (DIMM Slots)" FontSize="18" FontWeight="SemiBold" />
            <ListView x:Name="LstMemorySticks" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PhysicalMemoryStick">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,4">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="8" Width="44" Height="44" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE964;" FontSize="20" Foreground="White" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind DeviceLocator}" FontSize="15" FontWeight="Bold" />
                                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{x:Bind FormattedCapacity}" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{x:Bind MemoryType}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,1">
                                            <TextBlock Text="{x:Bind FormFactor}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Manufacturer}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{x:Bind PartNumber}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind SerialNumber}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FormattedSpeed}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind FormattedRatedSpeed}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Memory Properties Grouped by Category -->
            <TextBlock Text="Memory Diagnostics &amp; Architecture" FontSize="18" FontWeight="SemiBold" />
            <ItemsControl x:Name="LstMemoryPropertyGroups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PropertyGroup">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16,12"
                                Margin="0,0,0,16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Width="4" Height="16" />
                                    <TextBlock Text="{x:Bind Category}" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </StackPanel>

                                <ListView ItemsSource="{x:Bind Items}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:PropertyItem">
                                            <Grid ColumnDefinitions="260,*" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                <TextBlock Text="{x:Bind Property}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayValue}" FontSize="13" FontWeight="Medium" IsTextSelectionEnabled="True" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
