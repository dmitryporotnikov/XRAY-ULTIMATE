<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="XRAY_ULTIMATE.Views.FiltersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:XRAY_ULTIMATE.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20,28,40">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">
            <!-- Header Banner Card (matching CpuPage design) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24,20">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="12" Width="64" Height="64" Margin="0,0,20,0" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE71C;" FontSize="32" Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Driver &amp; System Filter Subsystem" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="Filesystem Minifilters (fltmc) &amp; NDIS Lightweight Filter Drivers" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtCountBadge" Text="Filters: 0" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="BtnExportCsv" Click="BtnExportCsv_Click" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="13" />
                            <TextBlock Text="Export CSV" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Search & Mode Toolbar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBox x:Name="TxtSearch" PlaceholderText="Search filter drivers by name, altitude, or class..." TextChanged="TxtSearch_TextChanged" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <RadioButton x:Name="RbFsFilters" Content="Filesystem Minifilters (fltmc)" IsChecked="True" Checked="FilterMode_Changed" FontWeight="SemiBold" />
                        <RadioButton x:Name="RbNetFilters" Content="Network Filters (NDIS LWF)" Checked="FilterMode_Changed" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,8">
                <Grid>
                    <!-- Filesystem Minifilters List -->
                    <ItemsControl x:Name="LstFsFilters">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FilesystemFilter">
                                <Grid ColumnDefinitions="*,120,180,80,60" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FilterName}" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Altitude" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind Altitude}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind Category}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>

                                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Instances" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind NumInstances}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Frame" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock Text="{x:Bind Frame}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Network Filter Drivers List -->
                    <ItemsControl x:Name="LstNetFilters" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:NetworkFilterDriver">
                                <Grid ColumnDefinitions="*,160,180,90" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="Bold" FontSize="14" />
                                        <TextBlock Text="{x:Bind ServiceName}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind FilterClass}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{x:Bind FilterType}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                    <Border Grid.Column="3" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind State}" FontSize="11" FontWeight="SemiBold" Foreground="LimeGreen" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
